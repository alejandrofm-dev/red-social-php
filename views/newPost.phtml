<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <h1>Crear nuevo post</h1>

    <form action="index.php?c=post&create" method="POST" enctype="multipart/form-data">
        <label for="caption">Descripción:</label>
        <input type="text" id="caption" name="caption">

        <label for="image">Cargar imagen:</label>
        <input type="file" id="image" name="image" accept="image/*">

        <div>
            <img id="preview" alt="Vista previa" width="250" style="display:none;">
        </div>

        <button type="submit">Crear</button>
    </form>

    <script>
        const input = document.getElementById('image');
        const preview = document.getElementById('preview');
        let currentUrl = null;

        input.addEventListener('change', () => {
            if (currentUrl) {
                URL.revokeObjectURL(currentUrl);
                currentUrl = null;
            }
            const file = input.files[0];
            if (file) {
                currentUrl = URL.createObjectURL(file);
                preview.src = currentUrl;
                preview.style.display = 'block';
            } else {
                preview.removeAttribute('src');
                preview.style.display = 'none';
            }
        });
    </script>

</body>

</html>